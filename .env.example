# Robinhood Chain RPC (optional override)
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Trading wallet private key (required for live trading)
PRIVATE_KEY=

# Safety switches — live trading requires DRY_RUN=false AND CONFIRM_LIVE_TRADING=YES
DRY_RUN=true
CONFIRM_LIVE_TRADING=NO

# Optional: target a specific token instead of auto-detecting launches
# TARGET_TOKEN=0x39dBED3a2bd333467115dE45665cC57F813C4571
